# Oracly — imagem leve só com Node + dist/ (sem Playwright)
# Serve o dashboard (HTML) e os endpoints /api/* na porta 3000.

FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY tsconfig.json ./
COPY src/ ./src/
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
ENV DASHBOARD_PORT=3000
ENV OUTPUT_PATH=storage/output
ENV LOG_LEVEL=info

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/dist ./dist
COPY src/dashboard/index.html ./dist/dashboard/index.html

RUN mkdir -p storage/output storage/logs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.DASHBOARD_PORT+'/api/files').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/cli/run.js", "dashboard"]
