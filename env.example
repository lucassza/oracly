# SokkerPRO Configuration
SOKKERPRO_BASE_URL=https://sokkerpro.com
SOKKERPRO_API_BASE_URL=https://m2.sokkerpro.com
SOKKERPRO_EMAIL=
SOKKERPRO_PASSWORD=
SOKKERPRO_STORAGE_STATE_PATH=storage/sessions/sokkerpro.json

# Playwright Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_LOCALE=pt-BR
PLAYWRIGHT_TIMEZONE=America/Sao_Paulo

# Scraper Configuration
SCRAPER_DATE=
SCRAPER_CONCURRENCY=2
SCRAPER_DELAY_MIN_MS=1000
SCRAPER_DELAY_MAX_MS=3000
SCRAPER_MAX_RETRIES=3
SCRAPER_SAVE_RAW_DATA=false

# Output Configuration
LOG_LEVEL=info
OUTPUT_PATH=storage/output
DASHBOARD_PORT=3000
SCREENSHOT_PATH=storage/screenshots

# Postgres Configuration
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public

