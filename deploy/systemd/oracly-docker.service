[Unit]
Description=Oracly Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/www/oracly
ExecStart=/usr/bin/docker compose --profile automation up -d --build
ExecStop=/usr/bin/docker compose --profile automation down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
